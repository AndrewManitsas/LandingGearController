<sdf version="1.8">
    <!-- Flat, rigid concrete runway (0 deg slope, rigid acoustic-optical reflection, labeled SAFE) -->
    <world name="testbed_alpha">
        <physics name="1ms" type="ignored">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
        </physics>

        <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 15 0 0 0</pose>
        <diffuse>0.9 0.9 0.9 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
        <static>true</static>
        <link name="link">
            <collision name="collision">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
                </plane>
            </geometry>
            <surface>
                <friction>
                <ode>
                    <mu>1.0</mu>
                    <mu2>1.0</mu2>
                </ode>
                </friction>
            </surface>
            </collision>
            <visual name="visual">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.5 0.5 0.5 1</ambient>
                <diffuse>0.6 0.6 0.6 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
            </visual>
        </link>
        </model>
    </world>
</sdf>