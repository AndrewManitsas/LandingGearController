<?xml version="1.0"?>
<robot name="uav_landing_rig">
    <!-- World Anchor (Locks the rig 0.5m in the air for testing) -->
    <link name="world"/>
    <joint name="fixed_mount" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </joint>

    <!-- Base Chassis -->
    <link name="base_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="0.20 0.20 0.05"/>
        </geometry>
        <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="0.20 0.20 0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.20"/>
        <inertia ixx="0.00425" ixy="0.0" ixz="0.0" iyy="0.00425" iyz="0.0" izz="0.00800"/>
    </inertial>
    </link>

    <!-- Pitch Stabilizer Servo (Y-axis) -->
    <joint name="pitch_stabilizer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="sensor_plate_link"/>
    <origin xyz="0.0 0.0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="1.0" velocity="5.0"/>
    <dynamics damping="0.01" friction="0.005"/>
    </joint>

    <!-- Sensor Plate Link -->
    <link name="sensor_plate_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="0.075" length="0.006"/>
        </geometry>
        <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="0.075" length="0.006"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.08"/>
        <inertia ixx="0.00011" ixy="0.0" ixz="0.0" iyy="0.00011" iyz="0.0" izz="0.00022"/>
    </inertial>
    </link>

    <!-- Landing Gear Deploy Servo (0 rad = Stowed Horizontal, 1.571 rad = Deployed Vertical) -->
    <joint name="landing_gear_joint" type="revolute">
        <parent link="base_link"/>
        <child link="landing_gear_link"/>
        <origin xyz="0.0 0.0 -0.025" rpy="0 0 0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="0.0" upper="1.5708" effort="1.0" velocity="4.0"/>
        <dynamics damping="0.02" friction="0.01"/>
    </joint>

    <!-- Landing Gear Strut Link -->
    <link name="landing_gear_link">
        <visual>
        <origin xyz="0 0.06 0" rpy="1.5708 0 0"/>
        <geometry>
            <cylinder radius="0.006" length="0.12"/>
        </geometry>
        <material name="orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
        </visual>
        <collision>
        <origin xyz="0 0.06 0" rpy="1.5708 0 0"/>
        <geometry>
            <cylinder radius="0.006" length="0.12"/>
        </geometry>
        </collision>
        <inertial>
        <origin xyz="0 0.06 0" rpy="1.5708 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00006" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.00006"/>
        </inertial>
    </link>

    <!-- Actuator Plugins -->
    <gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>pitch_stabilizer_joint</joint_name>
        <topic>/model/uav_landing_rig/joint/pitch_stabilizer_joint/0/cmd_pos</topic>
        <p_gain>20.0</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>1.0</d_gain>
    </plugin>

    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>landing_gear_joint</joint_name>
        <topic>/model/uav_landing_rig/joint/landing_gear_joint/0/cmd_pos</topic>
        <p_gain>15.0</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>0.5</d_gain>
    </plugin>
    </gazebo>
</robot>