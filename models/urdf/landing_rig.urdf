<robot name="uav_landing_rig">
    <!-- ==================== WORLD ANCHOR (TEST STAND) ==================== -->
    <link name="world"/>
    <joint name="fixed_mount" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.60" rpy="0 0 0"/>
    </joint>

    <!-- ==================== MATERIALS ==================== -->
    <material name="carbon_fiber"><color rgba="0.15 0.15 0.15 1.0"/></material>
    <material name="arm_red"><color rgba="0.8 0.1 0.1 1.0"/></material>
    <material name="arm_white"><color rgba="0.85 0.85 0.85 1.0"/></material>
    <material name="motor_silver"><color rgba="0.4 0.4 0.45 1.0"/></material>
    <material name="gimbal_blue"><color rgba="0.1 0.35 0.8 1.0"/></material>
    <material name="gear_orange"><color rgba="0.95 0.4 0.05 1.0"/></material>
    <material name="rubber_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    <material name="sensor_gold"><color rgba="0.85 0.7 0.1 1.0"/></material>

    <!-- ==================== BASE CHASSIS ==================== -->
    <link name="base_link">
    <!-- Center Avionics Pod -->
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.16 0.16 0.04"/></geometry>
        <material name="carbon_fiber"/>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.16 0.16 0.04"/></geometry>
    </collision>

    <!-- Arm 1: Front-Right -->
    <visual>
        <origin xyz="0.12 0.12 0.005" rpy="0 1.5708 0.7854"/>
        <geometry><cylinder radius="0.008" length="0.22"/></geometry>
        <material name="arm_red"/>
    </visual>
    <visual>
        <origin xyz="0.20 0.20 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.025"/></geometry>
        <material name="motor_silver"/>
    </visual>

    <!-- Arm 2: Front-Left -->
    <visual>
        <origin xyz="-0.12 0.12 0.005" rpy="0 1.5708 -0.7854"/>
        <geometry><cylinder radius="0.008" length="0.22"/></geometry>
        <material name="arm_red"/>
    </visual>
    <visual>
        <origin xyz="-0.20 0.20 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.025"/></geometry>
        <material name="motor_silver"/>
    </visual>

    <!-- Arm 3: Rear-Left -->
    <visual>
        <origin xyz="-0.12 -0.12 0.005" rpy="0 1.5708 0.7854"/>
        <geometry><cylinder radius="0.008" length="0.22"/></geometry>
        <material name="arm_white"/>
    </visual>
    <visual>
        <origin xyz="-0.20 -0.20 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.025"/></geometry>
        <material name="motor_silver"/>
    </visual>

    <!-- Arm 4: Rear-Right -->
    <visual>
        <origin xyz="0.12 -0.12 0.005" rpy="0 1.5708 -0.7854"/>
        <geometry><cylinder radius="0.008" length="0.22"/></geometry>
        <material name="arm_white"/>
    </visual>
    <visual>
        <origin xyz="0.20 -0.20 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.025"/></geometry>
        <material name="motor_silver"/>
    </visual>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.20"/>
        <inertia ixx="0.0085" ixy="0.0" ixz="0.0" iyy="0.0085" iyz="0.0" izz="0.0150"/>
    </inertial>
    </link>

    <!-- ==================== PITCH STABILIZER GIMBAL ==================== -->
    <joint name="pitch_stabilizer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="sensor_plate_link"/>
    <origin xyz="0.04 0.0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="1.0" velocity="5.0"/>
    <dynamics damping="0.01" friction="0.005"/>
    </joint>

    <link name="sensor_plate_link">
    <!-- Gimbal Yoke Brackets -->
    <visual>
        <origin xyz="0.0 0.05 0.015" rpy="0 0 0"/>
        <geometry><box size="0.015 0.008 0.03"/></geometry>
        <material name="carbon_fiber"/>
    </visual>
    <visual>
        <origin xyz="0.0 -0.05 0.015" rpy="0 0 0"/>
        <geometry><box size="0.015 0.008 0.03"/></geometry>
        <material name="carbon_fiber"/>
    </visual>

    <!-- Stabilized Payload Disk -->
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.065" length="0.006"/></geometry>
        <material name="gimbal_blue"/>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.065" length="0.006"/></geometry>
    </collision>

    <!-- Sonar Pod Visuals -->
    <visual>
        <origin xyz="0.012 0.0 -0.008" rpy="0 0 0"/>
        <geometry><cylinder radius="0.007" length="0.01"/></geometry>
        <material name="sensor_gold"/>
    </visual>
    <visual>
        <origin xyz="-0.012 0.0 -0.008" rpy="0 0 0"/>
        <geometry><cylinder radius="0.007" length="0.01"/></geometry>
        <material name="sensor_gold"/>
    </visual>

    <!-- 3x ToF Optical Indicators -->
    <visual>
        <origin xyz="0.045 0.0 -0.004" rpy="0 0 0"/>
        <geometry><box size="0.010 0.012 0.003"/></geometry>
        <material name="carbon_fiber"/>
    </visual>
    <visual>
        <origin xyz="-0.0225 0.039 -0.004" rpy="0 0 0"/>
        <geometry><box size="0.010 0.012 0.003"/></geometry>
        <material name="carbon_fiber"/>
    </visual>
    <visual>
        <origin xyz="-0.0225 -0.039 -0.004" rpy="0 0 0"/>
        <geometry><box size="0.010 0.012 0.003"/></geometry>
        <material name="carbon_fiber"/>
    </visual>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.09"/>
        <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00024"/>
    </inertial>
    </link>

    <!-- ==================== DUAL-LEG RETRACTABLE LANDING GEAR ==================== -->
    <!-- Hinge placed behind gimbal; axis rotates around Y so both legs swing down together -->
    <joint name="landing_gear_joint" type="revolute">
    <parent link="base_link"/>
    <child link="landing_gear_link"/>
    <origin xyz="-0.04 0.0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="1.5708" effort="1.5" velocity="4.0"/>
    <dynamics damping="0.02" friction="0.01"/>
    </joint>

    <link name="landing_gear_link">
    <!-- Cross Pivot Axle (Transverse torque tube) -->
    <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.006" length="0.20"/></geometry>
        <material name="gear_orange"/>
    </visual>

    <!-- Left Leg Strut (Horizontal along -X at rest) -->
    <visual>
        <origin xyz="-0.09 0.09 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.005" length="0.18"/></geometry>
        <material name="gear_orange"/>
    </visual>
    <collision>
        <origin xyz="-0.09 0.09 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.005" length="0.18"/></geometry>
    </collision>

    <!-- Right Leg Strut (Horizontal along -X at rest) -->
    <visual>
        <origin xyz="-0.09 -0.09 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.005" length="0.18"/></geometry>
        <material name="gear_orange"/>
    </visual>
    <collision>
        <origin xyz="-0.09 -0.09 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.005" length="0.18"/></geometry>
    </collision>

    <!-- Left Rubber Landing Footpad -->
    <visual>
        <origin xyz="-0.18 0.09 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.014"/></geometry>
        <material name="rubber_black"/>
    </visual>
    <collision>
        <origin xyz="-0.18 0.09 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.014"/></geometry>
    </collision>

    <!-- Right Rubber Landing Footpad -->
    <visual>
        <origin xyz="-0.18 -0.09 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.014"/></geometry>
        <material name="rubber_black"/>
    </visual>
    <collision>
        <origin xyz="-0.18 -0.09 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.014"/></geometry>
    </collision>

    <inertial>
        <origin xyz="-0.09 0 0" rpy="0 0 0"/>
        <mass value="0.10"/>
        <inertia ixx="0.00030" ixy="0.0" ixz="0.0" iyy="0.00020" iyz="0.0" izz="0.00020"/>
    </inertial>
    </link>

    <!-- ==================== GAZEBO ACTUATOR PLUGINS ==================== -->
    <gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>pitch_stabilizer_joint</joint_name>
        <topic>/model/uav_landing_rig/joint/pitch_stabilizer_joint/0/cmd_pos</topic>
        <p_gain>25.0</p_gain>
        <i_gain>0.2</i_gain>
        <d_gain>1.2</d_gain>
    </plugin>

    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>landing_gear_joint</joint_name>
        <topic>/model/uav_landing_rig/joint/landing_gear_joint/0/cmd_pos</topic>
        <p_gain>20.0</p_gain>
        <i_gain>0.2</i_gain>
        <d_gain>0.8</d_gain>
    </plugin>
    </gazebo>
</robot>