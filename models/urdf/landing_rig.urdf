<?xml version="1.0"?>
<robot name="uav_landing_rig">
	<!-- ==================== TEST STAND MOUNT ==================== -->
	<link name="world"/>
	<joint name="fixed_mount" type="fixed">
	<parent link="world"/>
	<child link="base_link"/>
	<origin xyz="0 0 0.70" rpy="0 0 0"/>
	</joint>

	<!-- ==================== MATERIALS ==================== -->
	<material name="fuselage_grey"><color rgba="0.80 0.82 0.85 1.0"/></material>
	<material name="wing_white"><color rgba="0.92 0.92 0.92 1.0"/></material>
	<material name="tail_red"><color rgba="0.85 0.15 0.15 1.0"/></material>
	<material name="carbon_black"><color rgba="0.12 0.12 0.12 1.0"/></material>
	<material name="gear_orange"><color rgba="0.95 0.40 0.05 1.0"/></material>
	<material name="wheel_rubber"><color rgba="0.05 0.05 0.05 1.0"/></material>
	<material name="sensor_gold"><color rgba="0.85 0.70 0.10 1.0"/></material>

	<!-- ==================== MAIN AIRFRAME ==================== -->
	<link name="base_link">
	<!-- Fuselage Body Tube -->
	<visual>
		<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.055" length="0.70"/></geometry>
		<material name="fuselage_grey"/>
	</visual>
	<collision>
		<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.055" length="0.70"/></geometry>
	</collision>

	<!-- Tapered Tail Cone -->
	<visual>
		<origin xyz="-0.40 0 0" rpy="0 -1.5708 0"/>
		<geometry><cylinder radius="0.054" length="0.10"/></geometry>
		<material name="fuselage_grey"/>
	</visual>

	<!-- Nose Cone -->
	<visual>
		<origin xyz="0.38 0 0" rpy="0 1.5708 0"/>
		<geometry><sphere radius="0.054"/></geometry>
		<material name="carbon_black"/>
	</visual>

	<!-- Main High-Wing -->
	<visual>
		<origin xyz="0.06 0 0.055" rpy="0 0 0"/>
		<geometry><box size="0.16 0.90 0.015"/></geometry>
		<material name="wing_white"/>
	</visual>
	<collision>
		<origin xyz="0.06 0 0.055" rpy="0 0 0"/>
		<geometry><box size="0.16 0.90 0.015"/></geometry>
	</collision>

	<!-- T-Tail Vertical Fin Mast -->
	<visual>
		<origin xyz="-0.32 0 0.13" rpy="0 -0.20 0"/>
		<geometry><box size="0.11 0.014 0.16"/></geometry>
		<material name="tail_red"/>
	</visual>
	<collision>
		<origin xyz="-0.32 0 0.13" rpy="0 -0.20 0"/>
		<geometry><box size="0.11 0.014 0.16"/></geometry>
	</collision>

	<!-- Ventral Sensor Bay Plate -->
	<visual>
		<origin xyz="0.15 0 -0.055" rpy="0 0 0"/>
		<geometry><box size="0.14 0.10 0.006"/></geometry>
		<material name="carbon_black"/>
	</visual>

	<!-- Sonar Aperture Housing -->
	<visual>
		<origin xyz="0.15 0 -0.060" rpy="0 0 0"/>
		<geometry><cylinder radius="0.012" length="0.008"/></geometry>
		<material name="sensor_gold"/>
	</visual>

	<inertial>
		<origin xyz="0.02 0 0" rpy="0 0 0"/>
		<mass value="1.60"/>
		<inertia ixx="0.045" ixy="0.0" ixz="0.0"
				iyy="0.025" iyz="0.0"
				izz="0.065"/>
	</inertial>
	</link>

	<!-- ==================== T-TAIL HORIZONTAL STABILATOR ==================== -->
	<joint name="horizontal_stabilizer_joint" type="revolute">
	<parent link="base_link"/>
	<child link="horizontal_stabilizer_link"/>
	<origin xyz="-0.335 0 0.21" rpy="0 0 0"/>
	<axis xyz="0 1 0"/>
	<limit lower="-0.4363" upper="0.4363" effort="1.2" velocity="6.0"/>
	<dynamics damping="0.02" friction="0.005"/>
	</joint>

	<link name="horizontal_stabilizer_link">
	<visual>
		<origin xyz="-0.02 0 0" rpy="0 0 0"/>
		<geometry><box size="0.08 0.36 0.008"/></geometry>
		<material name="tail_red"/>
	</visual>
	<collision>
		<origin xyz="-0.02 0 0" rpy="0 0 0"/>
		<geometry><box size="0.08 0.36 0.008"/></geometry>
	</collision>
	<visual>
		<origin xyz="-0.01 0 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.012" length="0.10"/></geometry>
		<material name="tail_red"/>
	</visual>
	<inertial>
		<origin xyz="-0.02 0 0" rpy="0 0 0"/>
		<mass value="0.05"/>
		<inertia ixx="0.0005" ixy="0.0" ixz="0.0"
				iyy="0.0001" iyz="0.0"
				izz="0.0006"/>
	</inertial>
	</link>

	<!-- ==================== RETRACTABLE LANDING GEAR ==================== -->
	<joint name="landing_gear_joint" type="revolute">
	<parent link="base_link"/>
	<child link="landing_gear_link"/>
	<origin xyz="0.04 0 -0.05" rpy="0 0 0"/>
	<axis xyz="0 -1 0"/>
	<limit lower="0.0" upper="1.5708" effort="2.0" velocity="3.5"/>
	<dynamics damping="0.03" friction="0.01"/>
	</joint>

	<link name="landing_gear_link">
	<visual>
		<origin xyz="0 0 0" rpy="1.5708 0 0"/>
		<geometry><cylinder radius="0.006" length="0.14"/></geometry>
		<material name="gear_orange"/>
	</visual>
	<visual>
		<origin xyz="-0.08 0.07 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.005" length="0.16"/></geometry>
		<material name="gear_orange"/>
	</visual>
	<collision>
		<origin xyz="-0.08 0.07 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.005" length="0.16"/></geometry>
	</collision>
	<visual>
		<origin xyz="-0.08 -0.07 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.005" length="0.16"/></geometry>
		<material name="gear_orange"/>
	</visual>
	<collision>
		<origin xyz="-0.08 -0.07 0" rpy="0 1.5708 0"/>
		<geometry><cylinder radius="0.005" length="0.16"/></geometry>
	</collision>
	<visual>
		<origin xyz="-0.16 0.07 0" rpy="1.5708 0 0"/>
		<geometry><cylinder radius="0.024" length="0.016"/></geometry>
		<material name="wheel_rubber"/>
	</visual>
	<collision>
		<origin xyz="-0.16 0.07 0" rpy="1.5708 0 0"/>
		<geometry><cylinder radius="0.024" length="0.016"/></geometry>
	</collision>
	<visual>
		<origin xyz="-0.16 -0.07 0" rpy="1.5708 0 0"/>
		<geometry><cylinder radius="0.024" length="0.016"/></geometry>
		<material name="wheel_rubber"/>
	</visual>
	<collision>
		<origin xyz="-0.16 -0.07 0" rpy="1.5708 0 0"/>
		<geometry><cylinder radius="0.024" length="0.016"/></geometry>
	</collision>
	<inertial>
		<origin xyz="-0.08 0 0" rpy="0 0 0"/>
		<mass value="0.11"/>
		<inertia ixx="0.0004" ixy="0.0" ixz="0.0"
				iyy="0.0002" iyz="0.0"
				izz="0.0002"/>
	</inertial>
	</link>

	<!-- ==================== GAZEBO SENSORS ON BASE_LINK ==================== -->
	<gazebo reference="base_link">
		<!-- 9-DoF IMU -->
		<sensor name="imu_sensor" type="imu">
			<always_on>1</always_on>
			<update_rate>100.0</update_rate>
			<visualize>true</visualize>
			<topic>/model/uav_landing_rig/imu</topic>
			<imu>
			<angular_velocity>
				<x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
				<y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
				<z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
			</angular_velocity>
			<linear_acceleration>
				<x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
				<y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
				<z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
			</linear_acceleration>
			</imu>
		</sensor>

		<!-- Downward Sonar -->
		<sensor name="sonar_down" type="gpu_lidar">
			<pose>0.15 0 -0.06 0 1.5708 0</pose>
			<always_on>1</always_on>
			<update_rate>20.0</update_rate>
			<visualize>false</visualize>
			<topic>/model/uav_landing_rig/sonar_down</topic>
			<ray>
			<scan>
				<horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></horizontal>
				<vertical><samples>5</samples><resolution>1</resolution><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical>
			</scan>
			<range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
			</ray>
		</sensor>

		<!-- ToF 1 (Fore) -->
		<sensor name="tof_1" type="gpu_lidar">
			<pose>0.195 0 -0.06 0 1.5708 0</pose>
			<always_on>1</always_on>
			<update_rate>50.0</update_rate>
			<visualize>false</visualize>
			<topic>/model/uav_landing_rig/tof_1</topic>
			<ray>
			<scan>
				<horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
			</scan>
			<range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
			</ray>
		</sensor>

		<!-- ToF 2 (Port) -->
		<sensor name="tof_2" type="gpu_lidar">
			<pose>0.125 0.039 -0.06 0 1.5708 0</pose>
			<always_on>1</always_on>
			<update_rate>50.0</update_rate>
			<visualize>false</visualize>
			<topic>/model/uav_landing_rig/tof_2</topic>
			<ray>
			<scan>
				<horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
			</scan>
			<range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
			</ray>
		</sensor>

		<!-- ToF 3 (Starboard) -->
		<sensor name="tof_3" type="gpu_lidar">
			<pose>0.125 -0.039 -0.06 0 1.5708 0</pose>
			<always_on>1</always_on>
			<update_rate>50.0</update_rate>
			<visualize>false</visualize>
			<topic>/model/uav_landing_rig/tof_3</topic>
			<ray>
			<scan>
				<horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
			</scan>
			<range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
			</ray>
		</sensor>
	</gazebo>

	<!-- ==================== GAZEBO SYSTEM PLUGINS ==================== -->
	<gazebo>
		<plugin
			filename="gz-sim-joint-position-controller-system"
			name="gz::sim::systems::JointPositionController">
			<joint_name>horizontal_stabilizer_joint</joint_name>
			<topic>/model/uav_landing_rig/joint/horizontal_stabilizer_joint/0/cmd_pos</topic>
			<p_gain>30.0</p_gain>
			<i_gain>0.2</i_gain>
			<d_gain>1.5</d_gain>
		</plugin>

		<plugin
			filename="gz-sim-joint-position-controller-system"
			name="gz::sim::systems::JointPositionController">
			<joint_name>landing_gear_joint</joint_name>
			<topic>/model/uav_landing_rig/joint/landing_gear_joint/0/cmd_pos</topic>
			<p_gain>25.0</p_gain>
			<i_gain>0.2</i_gain>
			<d_gain>1.0</d_gain>
		</plugin>

		<plugin
			filename="gz-sim-imu-system"
			name="gz::sim::systems::Imu">
		</plugin>

		<plugin
			filename="gz-sim-sensors-system"
			name="gz::sim::systems::Sensors">
			<render_engine>ogre</render_engine>
		</plugin>

		<plugin filename="gz-sim-velocity-control-system"
			name="gz::sim::systems::VelocityControl">
			<link_name>base_link</link_name>
		</plugin>
	</gazebo>

	<!-- Gazebo Harmonic Velocity Control System -->  
	<gazebo>
		<plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
			<topic>/model/uav_landing_rig/cmd_vel</topic>
		</plugin>
	</gazebo>
</robot>