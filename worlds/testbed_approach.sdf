<sdf version="1.8">
  <world name="testbed_approach">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Core Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Solid Base Ground Box -->
    <model name="approach_ground_box">
      <static>true</static>
      <pose>80 0 -0.10 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box><size>180 30 0.20</size></box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box><size>180 30 0.20</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SECTOR 1: VEGETATION & CANOPY MOUNDS (X = 5m to 25m) -->
    <model name="veg_canopy_1">
      <static>true</static>
      <pose>8.0 0.0 0.08 0 0 0</pose>
      <link name="canopy1_link">
        <collision name="col"><geometry><cylinder><radius>0.45</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.45</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="veg_mound_1">
      <static>true</static>
      <pose>13.0 0.2 0.05 0 0 0.3</pose>
      <link name="mound1_link">
        <collision name="col"><geometry><box><size>1.2 1.0 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 1.0 0.10</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="veg_canopy_2">
      <static>true</static>
      <pose>18.0 -0.1 0.08 0 0 0</pose>
      <link name="canopy2_link">
        <collision name="col"><geometry><cylinder><radius>0.50</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.50</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.12 0.42 0.12 1</ambient><diffuse>0.18 0.52 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="veg_mound_2">
      <static>true</static>
      <pose>23.0 0.0 0.06 0 0 -0.2</pose>
      <link name="mound2_link">
        <collision name="col"><geometry><box><size>1.5 1.2 0.12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 1.2 0.12</size></box></geometry>
          <material><ambient>0.18 0.48 0.18 1</ambient><diffuse>0.22 0.58 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SECTOR 2: 20-DEGREE SLOPE & STEPPED CURB (X = 35m to 55m) -->
    <!-- Scaled ramp: 2.2m length at 20 deg (0.349 rad) -> rises cleanly to Z = 0.42m -->
    <model name="approach_slope_ramp">
      <static>true</static>
      <pose>40.0 0.0 0.12 0.0 0.349066 0.0</pose>
      <link name="ramp_link">
        <collision name="col"><geometry><box><size>2.2 4.0 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.2 4.0 0.10</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.85 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Stepped curb: top at Z = 0.20m -->
    <model name="approach_stepped_curb">
      <static>true</static>
      <pose>48.0 0.0 0.10 0 0 0</pose>
      <link name="curb_link">
        <collision name="col"><geometry><box><size>1.6 4.0 0.20</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.6 4.0 0.20</size></box></geometry>
          <material><ambient>0.6 0.2 0.1 1</ambient><diffuse>0.65 0.25 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SECTOR 3: CLEAR RUNWAY THRESHOLD (X = 58m to 110m) -->
    <model name="approach_safe_runway">
      <static>true</static>
      <pose>85.0 0.0 0.005 0 0 0</pose>
      <link name="runway_link">
        <collision name="col">
          <geometry><box><size>54.0 6.0 0.01</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>54.0 6.0 0.01</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Runway Threshold Line -->
    <model name="runway_threshold_marker">
      <static>true</static>
      <pose>58.0 0.0 0.01 0 0 0</pose>
      <link name="marker_link">
        <visual name="vis">
          <geometry><box><size>1.5 4.0 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>